# Primary backend base URL (custom domain).
VITE_API_URL=http://localhost:8000

# Privy app ID for Google sign-in (https://dashboard.privy.io)
VITE_PRIVY_APP_ID=

# Optional fallback backend, tried when the primary is unreachable
# (e.g. networks that MITM-inspect the custom domain's TLS cert).
# VITE_API_FALLBACK_URL=https://your-backend.onrender.com
