{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/verify/claim/:id",
      "destination": "/api/verify-og"
    },
    {
      "source": "/verify/position/:id",
      "destination": "/api/verify-og"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
