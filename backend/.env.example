# Copy to backend/.env for local development.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local: SQLite. Production ($0): Neon/Supabase Postgres URL (pooled + sslmode=require).
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173
TWELVE_DATA_API_KEY=
ADMIN_ADDRESSES=0x8C66A1aBF7C949004aF7dE80A3fc0F691538ea74
# Image uploads (post images + avatars). Free Cloudinary account → Dashboard →
# "API Environment variable". Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
