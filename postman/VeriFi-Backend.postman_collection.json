              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"BTC will rise at least 5% over the next month\",\n  \"asset_id\": 1,\n  \"direction\": \"bullish\",\n  \"percentage\": 5.0,\n  \"until\": \"2026-05-10\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/posts/hard-claims/",
